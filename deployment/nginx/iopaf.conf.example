map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream iopaf_node {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name www.iopaf.net iopaf.net;

    client_max_body_size 10m;
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    # Enable only when the Nginx Brotli module is installed.
    # brotli on;
    # brotli_comp_level 5;
    # brotli_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    location = /app.html {
        proxy_pass http://iopaf_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering on;
        add_header Cache-Control "private, no-store, max-age=0" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location ~ ^/assets/.+\.(?:js|css)$ {
        proxy_pass http://iopaf_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering on;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ~ ^/(?:engine|fonts)/ {
        proxy_pass http://iopaf_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering on;
        add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400" always;
    }

    location /api/ {
        proxy_pass http://iopaf_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 95s;
        proxy_send_timeout 95s;
        proxy_buffering off;
        add_header Cache-Control "private, no-store" always;
    }

    location / {
        proxy_pass http://iopaf_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 95s;
        proxy_send_timeout 95s;
        proxy_buffering on;
    }
}
